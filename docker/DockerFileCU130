# --- Этап 1: Распаковка TensorRT ---
FROM nvidia/cuda:13.2.1-cudnn-devel-ubuntu24.04 AS trt-builder
COPY TensorRT-10.16.1.11.Linux.x86_64-gnu.cuda-13.2.tar.gz /tmp/
RUN mkdir -p /usr/src/tensorrt && \
    # --strip-components=1 убирает корневую папку из архива (TensorRT-10.x.x.x)
    tar -xzf /tmp/TensorRT-10.16.1.11.Linux.x86_64-gnu.cuda-13.2.tar.gz -C /usr/src/tensorrt --strip-components=1 && \
    rm /tmp/TensorRT-10.16.1.11.Linux.x86_64-gnu.cuda-13.2.tar.gz

# --- Этап 2: Финальный образ ---
FROM nvidia/cuda:13.2.1-cudnn-devel-ubuntu24.04

# Единая команда установки зависимостей
RUN DEBIAN_FRONTEND=noninteractive && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        nano cmake git smbclient curl \
        python3 python3-dev python3-pip python3-setuptools \
        freeglut3-dev build-essential libx11-dev libxmu-dev libxi-dev \
        libglu1-mesa libglu1-mesa-dev libssl-dev openssl libbz2-dev \
        libboost-all-dev ninja-build \
        '^libxcb.*-dev' libx11-xcb-dev libxkbcommon-dev libxkbcommon-x11-dev \
        libxrender-dev libxrender1 tree gnuplot python3-tk htop sshfs graphviz && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m pip install --no-cache-dir --break-system-packages simple-colors wheel

# Копируем ТОЛЬКО распакованные файлы TensorRT из первого этапа
COPY --from=trt-builder /usr/src/tensorrt /usr/src/tensorrt

# Установка Python-пакета TensorRT
RUN cd /usr/src/tensorrt/python && \
    pip install --break-system-packages tensorrt-*-cp312-none-linux_x86_64.whl

# Разбиваем ENV на две команды, чтобы избежать предупреждения UndefinedVar
ENV CUDAV=13.2

ENV CUDA_INCLUDE_DIRS=/usr/local/cuda-$CUDAV/targets/x86_64-linux/include/ \
    CUDA_CUDART_LIBRARY=/usr/local/cuda-$CUDAV/targets/x86_64-linux/lib/ \
    CUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda-$CUDAV/ \
    CUDA_HOME=/usr/local/cuda-$CUDAV \
    CMAKE_CUDA_COMPILER=/usr/local/cuda-$CUDAV/bin/nvcc \
    CUDACXX=/usr/local/cuda-$CUDAV/bin/nvcc \
    PATH=/usr/local/cuda-$CUDAV/bin:/usr/src/tensorrt/bin:$PATH \
    LD_LIBRARY_PATH="/usr/src/tensorrt/lib:$LD_LIBRARY_PATH" \
    TENSORRT_PATH=/usr/src/tensorrt

RUN apt-get update && apt-get install -y wget
WORKDIR /app